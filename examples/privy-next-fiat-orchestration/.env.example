# ── Client (inlined into the browser bundle — public by design) ──────────────
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# ── Server only — never prefix these with NEXT_PUBLIC_ ──────────────────────
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# Signing secret for the webhook endpoint you register in the Privy dashboard.
# Required to verify incoming user.kyc.updated webhooks.
PRIVY_WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Optional: a pre-seeded sandbox user shown to logged-out visitors. See the
# README ("Seed the showcase user"). Leave unset to hide the panel.
# SHOWCASE_USER_ID=did:privy:...
# SHOWCASE_WALLET_ID=your-showcase-wallet-id
