NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Optional. Only needed to sign up for a card in PRODUCTION. `SignUpForCardView` requires the
# on-chain spend-approval spender on production. New cards spend Tempo OUSD, so set this to your
# Tempo OUSD card program's production spender from your Bridge production integration.
# Sandbox doesn't need it. A missing spender is reported when signup starts.
NEXT_PUBLIC_CARD_SPENDER_ADDRESS=

# Optional. To resume an existing Base USDC production card, supply that card program's Base
# production spender. The example uses native Base USDC and never reuses the Tempo spender.
NEXT_PUBLIC_BASE_CARD_SPENDER_ADDRESS=

# Optional. Only needed for the "Simulate a purchase" button, which calls Stripe Issuing's test
# helpers from a route handler. Must be a TEST-mode key (sk_test_… or rk_test_…) for the same Stripe
# account that issues the cards. Server-only — never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
